# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/strata?sslmode=require"

# Password for /admin/flagship -- gated by src/proxy.ts
ADMIN_PASSWORD="change-me"

# Merriam-Webster Collegiate Dictionary API key (dictionaryapi.com) -- optional.
# Powers the read-only etymology reference blurb next to OE/ME era cards in
# the admin UI. Never re-fetched once cached; absence just means that
# best-effort feature stays off, core generation is unaffected.
MW_COLLEGIATE_API_KEY=""
